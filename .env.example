# My Business Journal — Personal Business Blog CMS
# Copy to .env for local dev. NEVER commit a real .env to GitHub.
# In Vercel: Project -> Settings -> Environment Variables, paste each value.
# Public vars are visible in the browser; secret vars must stay server-only.

# Public
NEXT_PUBLIC_SITE_NAME=My Business Journal
AUTHOR_NAME=Farhan Islam
CONTACT_EMAIL=
SITE_URL=
ANALYTICS_ENABLED=true
COMMENTS_ENABLED=true
ADMIN_ROUTE=/admin

# Server-only (secret — leave empty in the example, set in Vercel)
DATABASE_URL=file:./app.db
ADMIN_EMAIL=
SESSION_SECRET=
